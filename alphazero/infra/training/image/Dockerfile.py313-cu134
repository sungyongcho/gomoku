# syntax=docker/dockerfile:1.7
# GPU head image: Python 3.13 + torch 2.15.0 CUDA 13.4 build.
#
# Ray rejects a node whose Python patch version differs from the head's, so this image and
# Dockerfile.py313-cpu start from the same official Python image (keep PYTHON_IMAGE equal in both)
# and install shared packages under the same constraints.txt. check_image_versions.sh compares
# the two images' versions stage and fails before anything is pushed when they disagree.
#
# CUDA comes from the pip dependencies of the torch cu134 wheel (cuda-toolkit, cuDNN, NCCL); the
# NVIDIA driver comes from the host through `--gpus all`. PyTorch states CUDA 13 wheels need driver
# 580 or newer (CUDA 13.x minor version compatibility), which the head VM image family
# common-cu129-ubuntu-2204-nvidia-580 provides. torch 2.15.0 ships cu132 and cu134; cu134 is newest.
ARG PYTHON_IMAGE=python:3.13.18-slim-trixie

# ========= Base: Python 3.13 공통 베이스 =========
FROM ${PYTHON_IMAGE} AS pybase
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris
RUN ln -fs /usr/share/zoneinfo/$TZ /etc/localtime && \
	apt-get update && \
	apt-get install -y --no-install-recommends tzdata ca-certificates curl && \
	dpkg-reconfigure --frontend noninteractive tzdata && \
	rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=120 PYTHONUNBUFFERED=1
WORKDIR /app

# --- 수정 ---
# SHELL에서 -l (login) 플래그를 제거합니다.
# -l 플래그는 /etc/profile 등을 다시 로드하여 ENV로 설정한 PATH를 덮어쓸 수 있습니다.
# 이것이 'ModuleNotFoundError: no module named ray'의 원인이었습니다.
SHELL ["/bin/bash", "-c"]


# ========= Stage 1: Builder (모든 설치/컴파일은 여기서) =========
FROM pybase AS builder
# 빌드툴 & 헤더 (최종 런타임에는 미포함). The official Python image already ships its headers.
RUN apt-get update && \
	apt-get install -y --no-install-recommends \
	build-essential git pkg-config libffi-dev libssl-dev && \
	rm -rf /var/lib/apt/lists/*

# 전용 venv 생성 (이 디렉토리를 런타임으로 복사)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" VIRTUAL_ENV="/opt/venv"

# Versions shared with the CPU worker image.
COPY infra/training/image/constraints.txt /opt/constraints.txt
ENV PIP_CONSTRAINT=/opt/constraints.txt

# 기본 업그레이드
RUN python -m pip install --upgrade pip wheel setuptools

# Ray + GCP 의존성 (바이너리만 사용해 빌드시간 단축)
ENV CMAKE_BUILD_PARALLEL_LEVEL=1
RUN --mount=type=cache,target=/root/.cache/pip \
	python -m pip install --prefer-binary --only-binary=:all: \
	"ray[default]==2.60.0" fsspec gcsfs pyarrow tqdm PyYAML \
	google-api-python-client google-auth google-auth-httplib2 google-auth-oauthlib cryptography

# PyTorch CUDA 13.4. Pin the +cu134 local version so pip fails instead of falling back to PyPI's
# default CUDA build when the index lacks a wheel.
RUN --mount=type=cache,target=/root/.cache/pip \
	python -m pip install --extra-index-url https://download.pytorch.org/whl/cu134 \
	"torch==2.15.0+cu134"

# 나머지 파이썬 의존성 (pyproject.toml 기반)
COPY . /app
RUN --mount=type=cache,target=/root/.cache/pip \
	python -m pip install ".[ray]"

# --- 수정 ---
# 불필요 캐시/바이트코드 정리
# builder 스테이지는 버려지므로 /root/.cache/pip 정리는 불필요. venv 내부만 정리합니다.
RUN find /opt/venv -type d -name '__pycache__' -prune -exec rm -rf {} +
RUN python infra/training/image/image_versions.py > /opt/image-versions.txt


# ========= Versions: compared with the CPU image by check_image_versions.sh =========
FROM scratch AS versions
COPY --from=builder /opt/image-versions.txt /image-versions.txt


# ========= Stage 2: Runtime (슬림, default target) =========
FROM pybase AS runtime

# --- 수정 ---
# 런타임 유틸만 설치 (빌드용 'git' 제거)
RUN apt-get update && \
	apt-get install -y --no-install-recommends \
	rsync openssh-client iproute2 curl procps vim \
	build-essential git tzdata && \
	rm -rf /var/lib/apt/lists/*

# 빌더의 완성된 venv 복사
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/image-versions.txt /opt/image-versions.txt
ENV PATH="/opt/venv/bin:/usr/local/bin:$PATH" VIRTUAL_ENV="/opt/venv"
# Ask the NVIDIA container runtime for the GPU and its compute libraries; the nvidia/cuda images
# set these, the official Python image does not.
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

# --- 수정 ---
# wheel로 앱 코드는 venv에 설치되었습니다.
# ./scripts/train.py 같은 실행 스크립트만 builder에서 복사합니다.
COPY . /app

# 빌드타임 검증 (이제 SHELL 수정으로 인해 정상 동작합니다)
RUN echo "import sys, ssl, sqlite3, zlib, bz2, lzma, torch, ray, pyarrow, fsspec" > check_env.py \
	&& echo "print('python:', sys.version)" >> check_env.py \
	&& echo "print('ssl:', ssl.OPENSSL_VERSION)" >> check_env.py \
	&& echo "print('ray:', ray.__version__)" >> check_env.py \
	&& echo "print('cuda?', torch.cuda.is_available())" >> check_env.py \
	&& echo "print('torch:', torch.__version__, 'cuda:', torch.version.cuda)" >> check_env.py \
	&& echo "assert torch.version.cuda.startswith('13.4'), torch.version.cuda" >> check_env.py \
	&& echo "if torch.cuda.is_available(): print('device:', torch.cuda.get_device_name(0))" >> check_env.py \
	&& python check_env.py \
	&& rm check_env.py

# --- 수정 ---
# 컨테이너 기본 실행 명령을 스크립트 실행으로 변경
CMD ["python", "gomoku/scripts/train.py"]
