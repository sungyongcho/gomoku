# ============================================================
# Local Development
# ============================================================
LOCAL_FRONT=3000
LOCAL_FRONT_NUXT_CONTENT_WS=4000
LOCAL_MINIMAX=8005
LOCAL_MINIMAX_GDB=8006
LOCAL_ALPHAZERO=8080

# ============================================================
# Frontend
# ============================================================
FRONT_WHERE=prod #prod, local


# AlphaZero Training (Ray on GCP)
# ============================================================
GCP_PROJECT=
GCP_REGION=
GCP_ZONE=
GCP_REPO=
GCP_CLUSTER_NAME=
GCP_SSH_USER=
GCP_SSH_PRIVATE_KEY=
GCP_CONTAINER_NAME=
GCP_SA_NAME=
GCP_HEAD_RESERVATION=
GCP_GPU_TAG=
GCP_CPU_TAG=
GCP_USER_EMAIL=
GCP_BUCKET_NAME=

# ============================================================
# AlphaZero deployment (GCP VM, deploy/alphazero)
# ============================================================
DEPLOY_GCP_PROJECT=
DEPLOY_USER_EMAIL=
DEPLOY_GCP_REGION=
DEPLOY_GCP_ZONE=
DEPLOY_GCP_REPO=
DEPLOY_ALPHAZERO_VM=gomoku-alphazero
DEPLOY_ALPHAZERO_MACHINE=
ALPHAZERO_INFER_BACKEND=onnx-static
DEPLOY_SA_NAME=
DEPLOY_ALPHAZERO_CONFIG=configs/deploy.yaml # edit num_search, num_simulations, etc. for deployment
DEPLOY_ALPHAZERO_DEVICE=cpu
# Printed by deploy/alphazero/01_setup.sh; read by deploy/cloudflare/deploy.sh.
DEPLOY_ALPHAZERO_IP=

# ============================================================
# Cloudflare routing (deploy/cloudflare)
# minimax-api follows DEPLOY_MINIMAX_HOST, alphazero-api follows DEPLOY_ALPHAZERO_IP.
# ============================================================
DEPLOY_DOMAIN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================
# Minimax deployment (Oracle Cloud, deploy/minimax)
# See deploy/minimax/README.md.
# ============================================================
DEPLOY_MINIMAX_HOST=
DEPLOY_MINIMAX_SSH_USER=ubuntu
# DEPLOY_MINIMAX_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_MINIMAX_PORT=8080
# For deploy/minimax/00_security_list.sh (OCI CLI): the VCN security list to extend.
# DEPLOY_MINIMAX_SECURITY_LIST_OCID=ocid1.securitylist.oc1.eu-paris-1....
# DEPLOY_MINIMAX_SSH_SOURCE_CIDR=<your ip>/32   # default: current public IP

# ============================================================
# AlphaZero deployment (Oracle Cloud, deploy/alphazero-oracle)
# See deploy/alphazero-oracle/README.md.
# ============================================================
# DEPLOY_ALPHAZERO_A1_HOST=
# DEPLOY_ALPHAZERO_A1_SSH_USER=ubuntu
# DEPLOY_ALPHAZERO_A1_SSH_KEY=~/.ssh/<key>
# DEPLOY_ALPHAZERO_A1_PORT=8080
# The model served: a config under alphazero/ and the local checkpoint that matches it.
# DEPLOY_ALPHAZERO_A1_CONFIG=configs/deploy-v5.yaml
# DEPLOY_ALPHAZERO_A1_CHECKPOINT=
# DEPLOY_ALPHAZERO_A1_INFER_BACKEND=onnx-static
# DEPLOY_ALPHAZERO_A1_THREADS=2
