FROM python:3.13-slim-trixie

# Refresh Debian's CA bundle before fetching Python packages. DSA-6572-1 removes
# the compromised eMudhra trust paths in ca-certificates 20250419+deb13u1.
RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates \
	cmake \
	g++ \
	ninja-build \
	curl \
	&& dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge '20250419+deb13u1' \
	&& rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Copy source before install because scikit-build needs `cpp/` at build time.
COPY . /app
RUN pip install --no-cache-dir --upgrade pip \
	&& pip install --no-cache-dir ".[serve,torch-cpu]" \
	--extra-index-url https://download.pytorch.org/whl/cpu \
	&& pip install --no-cache-dir --upgrade 'certifi>=2026.10.19'

ENV PYTHONPATH=/app
ENV ALPHAZERO_CONFIG=configs/local_play.yaml
ENV ALPHAZERO_CHECKPOINT=models/champion.pt
ENV ALPHAZERO_DEVICE=cpu

# Thread count is decided at runtime from cgroup CPU limits in server.engine.

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
	CMD curl -fsS http://localhost:8080/ || exit 1

EXPOSE 8080
CMD ["uvicorn", "server:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
